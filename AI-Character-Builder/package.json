{
  "name": "ai-chatbot",
  "version": "1.0.0",
  "description": "Angular AI Chatbot with Configurable Character Personalities",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:mobile": "ng build --configuration development --delete-output-path=false",
    "build:apk": "ng build --configuration production && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "build:apk:release": "ng build --configuration production && npx cap sync android && cd android && .\\gradlew.bat assembleRelease",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/material": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@types/chrome": "^0.1.38",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@types/node": "^20.0.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.4.5"
  }
}
