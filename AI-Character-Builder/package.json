{
  "name": "ai-chatbot",
  "version": "1.0.0",
  "description": "Angular AI Chatbot with Configurable Character Personalities",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:mobile": "ng build --configuration development --delete-output-path=false",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cap:sync": "node scripts/pre-cap-sync.cjs && npx cap sync android",
    "android": "npx cap open android",
    "android:prepare": "npm run build:mobile && npm run cap:sync",
    "android:apk": "npm run android:prepare && cd android && gradlew.bat assembleDebug"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/material": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.5"
  }
}
